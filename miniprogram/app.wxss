page {
  background-color: #fafafa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
}

.container {
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.book-title {
  display: block;
  font-size: 30rpx;
  color: #888;
  font-weight: 400;
}

.chapter-title {
  display: block;
  font-size: 40rpx;
  color: #222;
  margin-top: 10rpx;
  font-weight: 600;
}
