<view class="container">
  <view class="header">
    <text class="title">大声朗读</text>
    <text class="subtitle">选择一本书开始阅读</text>
  </view>

  <view class="book-list">
    <view
      class="book-card"
      wx:for="{{books}}"
      wx:key="id"
      bindtap="openBook"
      data-book="{{item.id}}"
    >
      <text class="book-title">{{item.title}}</text>
      <text class="book-meta">{{item.author}} · {{item.meta}}</text>
    </view>
  </view>
</view>
