<view class="container">
  <view class="header">
    <text class="title">大声朗读</text>
    <text class="subtitle">选择一本书开始阅读</text>
  </view>

  <view class="book-list">
    <view class="book-card" bindtap="openBook" data-book="hp1" data-chapter="1">
      <text class="book-title">Harry Potter and the Philosopher's Stone</text>
      <text class="book-meta">J.K. Rowling · 第 1 章已上线</text>
    </view>
  </view>

  <view class="tip">
    <text>点击书籍后将进入朗读页面</text>
  </view>
</view>
