<view class="container">
  <view class="header" wx:if="{{book}}">
    <text class="book-title">{{book.title}}</text>
    <text class="chapter-title">{{currentChapter.title}} · {{currentChapter.desc}}</text>
  </view>

  <view class="controls" wx:if="{{!loading && !loadError}}">
    <picker mode="selector" range="{{speedOptions}}" value="{{speedIndex}}" bindchange="onSpeedChange">
      <view class="control-btn">速度: {{speedOptions[speedIndex]}}</view>
    </picker>
    <view class="control-btn {{isContinuous ? 'active' : ''}}" bindtap="toggleContinuous">
      连续播放
    </view>
    <view class="control-btn" bindtap="goBack">返回目录</view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text class="state-text">正在加载数据...</text>
  </view>

  <view class="error-state" wx:if="{{!loading && loadError}}">
    <text class="state-text">{{loadError}}</text>
  </view>

  <scroll-view class="content" scroll-y scroll-into-view="{{scrollIntoView}}" enhanced show-scrollbar wx:if="{{!loading && !loadError}}">
    <view class="sentence-block" wx:for="{{sentences}}" wx:key="id" wx:for-index="sIdx" id="sentence-{{sIdx}}">
      <view class="sentence-text">
        <text 
          wx:for="{{item.words}}" 
          wx:for-item="w" 
          wx:for-index="wIdx"
          wx:key="wIdx"
          class="word {{w.highlight ? 'highlight' : ''}} {{w.splitSelected ? 'split-selected' : ''}}"
          data-sidx="{{sIdx}}"
          data-widx="{{wIdx}}"
          bindtap="onWordTap"
        >{{w.text}} </text>
      </view>
      <view class="sentence-actions">
        <button class="play-btn" size="mini" data-index="{{sIdx}}" bindtap="playSentence">▶</button>
        <button class="split-btn" size="mini" data-index="{{sIdx}}" bindtap="openSplitModal">✂</button>
      </view>
    </view>
  </scroll-view>

  <!-- 拆分浮层：底部弹出 -->
  <page-container
    show="{{showSplitModal}}"
    position="bottom"
    overlay="true"
    duration="300"
    round="true"
    z-index="200"
    custom-style="height: 82vh;"
    bind:afterleave="onSplitModalClose"
  >
    <view class="split-sheet">
      <view class="sheet-header">
        <text class="sheet-title">句子拆分</text>
        <text class="sheet-close" bindtap="closeSplitModal">×</text>
      </view>
      <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar>
        <view class="sheet-sentence">
          <text 
            wx:for="{{splitWords}}" 
            wx:for-item="w" 
            wx:for-index="wIdx"
            wx:key="wIdx"
            class="word {{w.selected ? 'split-selected' : ''}}"
            data-index="{{wIdx}}"
            bindtap="selectSplitWord"
          >{{w.text}} </text>
        </view>
        <view class="sheet-actions">
          <button class="sheet-btn" size="mini" bindtap="splitByComma">按逗号拆分</button>
          <button class="sheet-btn" size="mini" bindtap="addSelectionFragment" disabled="{{splitStart === -1 || splitEnd === -1}}">添加选中片段</button>
        </view>
        <view class="fragments-list">
          <view class="fragment-row" wx:for="{{splitFragments}}" wx:key="index">
            <text class="fragment-text">{{index + 1}}. <text wx:for="{{item.words}}" wx:for-item="fw" wx:for-index="fwIdx" wx:key="fwIdx" class="word {{fw.highlight ? 'highlight' : ''}}">{{fw.text}} </text></text>
            <button class="fragment-play-btn" size="mini" data-index="{{index}}" bindtap="playFragment">▶</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </page-container>
</view>
