.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  flex-wrap: wrap;
}

.control-btn {
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  line-height: 1.4;
}

.control-btn.active {
  background: #4CAF50;
  border-color: #4CAF50;
  color: #fff;
}

.hint-text {
  width: 100%;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding-top: 8rpx;
}

.content {
  max-height: calc(100vh - 320rpx);
  padding-bottom: 40rpx;
}

.loading-state,
.error-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.state-text {
  font-size: 30rpx;
  color: #888;
}

.error-state .state-text {
  color: #e53935;
}

.sentence-block {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  margin: 4rpx 0;
  border-radius: 10rpx;
}

.sentence-text {
  flex: 1;
  font-size: 34rpx;
  line-height: 1.9;
  color: #333;
}

.word {
  border-radius: 4rpx;
  padding: 0 2rpx;
}

.word.highlight {
  background: #ffe082;
  color: #000;
}

.word.split-selected {
  background: #b3e5fc;
  color: #000;
}

.sentence-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.play-btn, .split-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.play-btn {
  color: #4CAF50;
  border: 1.5rpx solid #4CAF50;
}

.split-btn {
  color: #FF9800;
  border: 1.5rpx solid #FF9800;
}

/* 拆分浮层：底部 sheet */
.split-sheet {
  height: 100%;
  width: 100vw;
  max-width: 100vw;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.sheet-close {
  font-size: 48rpx;
  color: #888;
  line-height: 1;
  padding: 0 10rpx;
}

.sheet-body {
  flex: 1;
  width: 100%;
  padding: 24rpx 32rpx 40rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.sheet-sentence {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 8rpx;
  font-size: 34rpx;
  line-height: 1.6;
  color: #333;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.sheet-sentence .word-wrap {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  vertical-align: top;
}

.sheet-sentence .word-text {
  display: inline-block;
  white-space: nowrap;
}

.sheet-sentence .word-mark {
  font-size: 18rpx;
  color: #2196F3;
  line-height: 1;
  margin-top: 2rpx;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.sheet-btn {
  margin: 0;
}

.fragments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fragment-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
}

.fragment-text {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  min-width: 0;
}

.fragment-text .word {
  display: inline-block;
  margin-right: 6rpx;
  white-space: nowrap;
}

.fragment-play-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #4CAF50;
  border: 1.5rpx solid #4CAF50;
  flex-shrink: 0;
}
