.controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  flex-wrap: wrap;
}

.control-btn {
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  line-height: 1.4;
}

.control-btn.active {
  background: #4CAF50;
  border-color: #4CAF50;
  color: #fff;
}

.content {
  max-height: calc(100vh - 320rpx);
  padding-bottom: 40rpx;
}

.sentence-block {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  margin: 4rpx 0;
  border-radius: 10rpx;
}

.sentence-text {
  flex: 1;
  font-size: 34rpx;
  line-height: 1.9;
  color: #333;
}

.word {
  border-radius: 4rpx;
  padding: 0 2rpx;
}

.word.highlight {
  background: #ffe082;
  color: #000;
}

.word.split-selected {
  background: #b3e5fc;
  color: #000;
}

.sentence-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.play-btn, .split-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.play-btn {
  color: #4CAF50;
  border: 1.5rpx solid #4CAF50;
}

.split-btn {
  color: #FF9800;
  border: 1.5rpx solid #FF9800;
}

/* 拆分浮层 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal.hidden {
  display: none;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.modal-content {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  width: 90%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.modal-close {
  font-size: 48rpx;
  color: #888;
  line-height: 1;
}

.modal-body {
  padding: 24rpx 30rpx;
  max-height: 60vh;
}

.modal-sentence {
  font-size: 34rpx;
  line-height: 2;
  color: #333;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.modal-btn {
  margin: 0;
}

.fragments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fragment-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
}

.fragment-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.fragment-play-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #4CAF50;
  border: 1.5rpx solid #4CAF50;
  flex-shrink: 0;
}
